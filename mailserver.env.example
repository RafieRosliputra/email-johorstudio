# docker-mailserver configuration. Copy to `mailserver.env` and fill RELAY_*.
# Send-only: outbound is relayed through a smarthost; no inbound mail (port 25).

OVERRIDE_HOSTNAME=mail.johorstudio.com
POSTMASTER_ADDRESS=noreply@johorstudio.com
# TLS: a self-signed cert generated by setup.sh (internal/LAN use; clients skip verify)
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/docker-mailserver/ssl/cert.pem
SSL_KEY_PATH=/tmp/docker-mailserver/ssl/key.pem
PERMIT_DOCKER=connected-networks
ONE_DIR=1
LOG_LEVEL=info
ENABLE_UPDATE_CHECK=0

# Keep it lightweight (no inbound filtering needed for a send-only relay client)
ENABLE_CLAMAV=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_FAIL2BAN=0
ENABLE_POP3=0

# --- Outbound smarthost relay (REQUIRED for delivery) ---------------------
# Example (Brevo): RELAY_HOST=smtp-relay.brevo.com  RELAY_PORT=587
#   RELAY_USER=<your-brevo-login>  RELAY_PASSWORD=<your-brevo-smtp-key>
# The relay provider signs DKIM for johorstudio.com (add their DNS records),
# and SPF should include the relay. See README.
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=
